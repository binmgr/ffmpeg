cmake_cross "${SRC_DIR}/brotli-${BROTLI_VERSION}-arm64" "${BUILD_ROOT}/brotli-arm64" \
    -DBROTLI_DISABLE_TESTS=ON \
    -DBUILD_SHARED_LIBS=OFF
rm -rf "${SRC_DIR}/brotli-${BROTLI_VERSION}" "${SRC_DIR}/brotli-${BROTLI_VERSION}-arm64" "${SRC_DIR}/brotli.tar.gz"

# harfbuzz
clean_tree "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}" "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}-arm64"
download_extract harfbuzz.tar.xz "https://github.com/harfbuzz/harfbuzz/releases/download/${HARFBUZZ_VERSION}/harfbuzz-${HARFBUZZ_VERSION}.tar.xz"
cp -a "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}" "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}-arm64"
set_native_pkg_config
meson setup "${BUILD_ROOT}/harfbuzz-amd64" "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}" \
    --buildtype=release \
    --prefix=/opt/deps/amd64 \
    --libdir=lib \
    --default-library=static \
    -Dcpp_std=c++11 \
    -Dbenchmark=disabled \
    -Dcairo=disabled \
    -Ddocs=disabled \
    -Dfreetype=enabled \
    -Dglib=enabled \
    -Dgobject=disabled \
    -Dgraphite2=enabled \
    -Dicu=disabled \
    -Dintrospection=disabled \
    -Dtests=disabled \
    -Dutilities=disabled
