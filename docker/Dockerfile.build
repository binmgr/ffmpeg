# =============================================================================
# FFmpeg Build Environment
# =============================================================================
FROM alpine:latest

# Install build tools and available static libraries
RUN apk add --no-cache \
    build-base curl wget git autoconf automake libtool pkgconf cmake meson ninja bash diffutils \
    linux-headers tar xz bzip2 ca-certificates nasm yasm perl python3 \
    # Static libraries available in Alpine
    zlib-static openssl-libs-static \
    libogg-static libvorbis-static libtheora-static \
    libwebp-static freetype-static \
    aom-static \
    # freetype static dependencies
    bzip2-static libpng-static brotli-static \
    # Dev headers
    libogg-dev libvorbis-dev libtheora-dev \
    libwebp-dev freetype-dev \
    aom-dev openssl-dev zlib-dev \
    brotli-dev libpng-dev

ENV PREFIX=/opt/deps/amd64
RUN mkdir -p ${PREFIX} /build
WORKDIR /build

# x264
RUN git clone --depth 1 https://code.videolan.org/videolan/x264.git && cd x264 && \
    ./configure --prefix=${PREFIX} --enable-static --disable-cli && \
    make -j$(nproc) && make install && cd .. && rm -rf x264

# opus
RUN wget -q "https://downloads.xiph.org/releases/opus/opus-1.4.tar.gz" && \
    tar xzf opus-*.tar.gz && cd opus-*/ && \
    ./configure --prefix=${PREFIX} --disable-shared --enable-static && \
    make -j$(nproc) && make install && cd .. && rm -rf opus-*/

# lame
RUN wget -q "https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download" -O lame.tar.gz && \
    tar xzf lame.tar.gz && cd lame-*/ && \
    ./configure --prefix=${PREFIX} --disable-shared --enable-static --enable-nasm --disable-frontend && \
    make -j$(nproc) && make install && cd .. && rm -rf lame-*/

# libvpx
RUN wget -q "https://github.com/webmproject/libvpx/archive/refs/tags/v1.14.0.tar.gz" -O libvpx.tar.gz && \
    tar xzf libvpx.tar.gz && cd libvpx-*/ && \
    ./configure --prefix=${PREFIX} --disable-shared --enable-static \
        --disable-examples --disable-unit-tests --enable-vp9-highbitdepth && \
    make -j$(nproc) && make install && cd .. && rm -rf libvpx-*/

# fdk-aac
RUN wget -q "https://github.com/mstorsjo/fdk-aac/archive/refs/tags/v2.0.2.tar.gz" -O fdk-aac.tar.gz && \
    tar xzf fdk-aac.tar.gz && cd fdk-aac-*/ && \
    autoreconf -fi && ./configure --prefix=${PREFIX} --disable-shared --enable-static && \
    make -j$(nproc) && make install && cd .. && rm -rf fdk-aac-*/

RUN rm -rf /build/*

# Build script
COPY <<'EOF' /usr/local/bin/build-ffmpeg
#!/bin/sh
set -e
ARCH="${1:-amd64}"
FFMPEG_VERSION="${2:-}"

[ "$ARCH" != "amd64" ] && echo "Only amd64 supported" && exit 1

[ -z "$FFMPEG_VERSION" ] && FFMPEG_VERSION=$(wget -qO- https://ffmpeg.org/releases/ | grep -oE 'ffmpeg-[0-9]+\.[0-9]+(\.[0-9]+)?' | sed 's/ffmpeg-//' | sort -V | tail -1)

echo "Building FFmpeg ${FFMPEG_VERSION}..."
cd /build
wget -q "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"
tar xJf ffmpeg-${FFMPEG_VERSION}.tar.xz && cd ffmpeg-${FFMPEG_VERSION}

export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/opt/deps/amd64/lib/pkgconfig"

./configure --prefix=/tmp/ffmpeg-install \
    --enable-gpl --enable-version3 --enable-nonfree \
    --enable-static --disable-shared --disable-debug --disable-doc --disable-ffplay \
    --enable-libx264 --enable-libvpx --enable-libopus \
    --enable-libvorbis --enable-libtheora --enable-libmp3lame --enable-libfdk-aac \
    --enable-libfreetype --enable-libwebp --enable-libaom --enable-openssl \
    --pkg-config-flags="--static" \
    --extra-cflags="-I/usr/include -I/opt/deps/amd64/include" \
    --extra-ldflags="-L/usr/lib -L/opt/deps/amd64/lib -static"

make -j$(nproc)
strip ffmpeg ffprobe

mkdir -p /output
cp ffmpeg /output/ffmpeg-linux-amd64
cp ffprobe /output/ffprobe-linux-amd64
echo "${FFMPEG_VERSION}" > /output/VERSION
echo "Built: ffmpeg-linux-amd64, ffprobe-linux-amd64"
EOF

RUN chmod +x /usr/local/bin/build-ffmpeg
WORKDIR /workspace
CMD ["echo", "Usage: build-ffmpeg [amd64]"]
