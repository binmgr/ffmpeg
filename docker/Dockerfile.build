set_cross_pkg_config
meson setup "${BUILD_ROOT}/harfbuzz-arm64" "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}-arm64" \
    --cross-file "${CROSS_FILE}" \
    --buildtype=release \
    --prefix=/opt/deps/arm64 \
    --libdir=lib \
    --default-library=static \
    -Dcpp_std=c++11 \
    -Dbenchmark=disabled \
    -Dcairo=disabled \
    -Ddocs=disabled \
    -Dfreetype=enabled \
    -Dglib=enabled \
    -Dgobject=disabled \
    -Dgraphite2=enabled \
    -Dicu=disabled \
    -Dintrospection=disabled \
    -Dtests=disabled \
    -Dutilities=disabled
ninja -C "${BUILD_ROOT}/harfbuzz-arm64"
ninja -C "${BUILD_ROOT}/harfbuzz-arm64" install
rm -rf "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}" "${SRC_DIR}/harfbuzz-${HARFBUZZ_VERSION}-arm64" "${SRC_DIR}/harfbuzz.tar.xz"

# libass
clean_tree "${SRC_DIR}/libass-${LIBASS_VERSION}" "${SRC_DIR}/libass-${LIBASS_VERSION}-arm64"
download_extract libass.tar.xz "https://github.com/libass/libass/releases/download/${LIBASS_VERSION}/libass-${LIBASS_VERSION}.tar.xz"
cp -a "${SRC_DIR}/libass-${LIBASS_VERSION}" "${SRC_DIR}/libass-${LIBASS_VERSION}-arm64"
set_native_pkg_config
cd "${SRC_DIR}/libass-${LIBASS_VERSION}"
./configure \
    --prefix=/opt/deps/amd64 \
    --enable-static \
    --disable-shared \
    --disable-fontconfig \
    --disable-enca \
    --disable-libunibreak \
    --disable-require-system-font-provider
make
make install
set_cross_pkg_config
cd "${SRC_DIR}/libass-${LIBASS_VERSION}-arm64"
CFLAGS='-O2 -I/opt/sysroots/aarch64/usr/include' LDFLAGS='-L/opt/sysroots/aarch64/usr/lib' ./configure \
    --host="${TARGET_TRIPLET}" \
    --build="${HOST_TRIPLET}" \
    --prefix=/opt/deps/arm64 \
    --enable-static \
    --disable-shared \
    --disable-fontconfig \
    --disable-enca \
    --disable-libunibreak \
    --disable-require-system-font-provider
make
make install
rm -rf "${SRC_DIR}/libass-${LIBASS_VERSION}" "${SRC_DIR}/libass-${LIBASS_VERSION}-arm64" "${SRC_DIR}/libass.tar.xz"

for libdir in /opt/deps/amd64 /opt/deps/arm64; do
    find "${libdir}" -name '*.la' -delete
    find "${libdir}" -type f -name '*.so' -delete
    find "${libdir}" -type f -name '*.so.*' -delete
done

set_native_pkg_config
for pc in x264 x265 vpx dav1d SvtAv1Enc fdk-aac opus ogg vorbis vidstab rubberband zimg harfbuzz libass; do
    pkg-config --exists "${pc}"
    pkg-config --static --libs "${pc}" >/dev/null
    pkg-config --modversion "${pc}" >/dev/null
done
set_cross_pkg_config
for pc in x264 x265 vpx dav1d SvtAv1Enc fdk-aac opus ogg vorbis vidstab rubberband zimg harfbuzz libass; do
    pkg-config --exists "${pc}"
    pkg-config --static --libs "${pc}" >/dev/null
    pkg-config --modversion "${pc}" >/dev/null
done

cat > "${BUILD_ROOT}/fontconfig-test.c" <<'FC_EOF'
#include <fontconfig/fontconfig.h>
int main(void) { return FcInit() ? 0 : 1; }
FC_EOF

set_native_pkg_config
gcc "${BUILD_ROOT}/fontconfig-test.c" \
    -o "${BUILD_ROOT}/fontconfig-test-amd64" \
    $(pkg-config --static --cflags --libs fontconfig)

set_cross_pkg_config
aarch64-linux-gcc --sysroot=/opt/sysroots/aarch64 "${BUILD_ROOT}/fontconfig-test.c" \
    -o "${BUILD_ROOT}/fontconfig-test-arm64" \
    $(pkg-config --static --cflags --libs fontconfig)

cat > "${BUILD_ROOT}/x264-test.c" <<'X264_EOF'
#include <stdint.h>
#include <x264.h>
int main(void) { x264_param_t param; x264_param_default(&param); return 0; }
X264_EOF

set_native_pkg_config
gcc "${BUILD_ROOT}/x264-test.c" \
    -o "${BUILD_ROOT}/x264-test-amd64" \
    $(pkg-config --static --cflags --libs x264)

set_cross_pkg_config
aarch64-linux-gcc --sysroot=/opt/sysroots/aarch64 "${BUILD_ROOT}/x264-test.c" \
    -o "${BUILD_ROOT}/x264-test-arm64" \
    $(pkg-config --static --cflags --libs x264)

cat > "${BUILD_ROOT}/harfbuzz-test.c" <<'HARFBUZZ_EOF'
#include <hb.h>
int main(void) {
    hb_buffer_t *buffer = hb_buffer_create();
    hb_buffer_destroy(buffer);
    return 0;
}
HARFBUZZ_EOF

set_native_pkg_config
gcc "${BUILD_ROOT}/harfbuzz-test.c" \
    -o "${BUILD_ROOT}/harfbuzz-test-amd64" \
    $(pkg-config --static --cflags --libs harfbuzz)
set_cross_pkg_config
aarch64-linux-gcc --sysroot=/opt/sysroots/aarch64 "${BUILD_ROOT}/harfbuzz-test.c" \
    -o "${BUILD_ROOT}/harfbuzz-test-arm64" \
    $(pkg-config --static --cflags --libs harfbuzz)

rm -rf "${SRC_DIR}" "${BUILD_ROOT}"
EOF

RUN chmod +x /usr/local/bin/build-static-deps && /usr/local/bin/build-static-deps && rm -f /usr/local/bin/build-static-deps

# Pseudo-strip for cross targets that lack a native strip binary.
# When FFmpeg's Makefile calls `strip -o OUTPUT INPUT`, we copy INPUT to OUTPUT.
# In-place invocations (`strip FILE`) are silently ignored.
COPY <<'EOF' /usr/local/bin/cross-nostrip
#!/bin/sh
out=''
inp=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -*) shift ;;
        *)  inp="${inp:-$1}"; shift ;;
    esac
done
[ -n "$out" ] && [ -n "$inp" ] && cp -- "$inp" "$out"
EOF
RUN chmod +x /usr/local/bin/cross-nostrip

# macOS: SDK + clang/LLVM wrappers for both darwin triples.
# clang on Alpine has full multi-target support including Mach-O.
# -nostdlibinc keeps clang's own builtin headers (stddef.h, float.h) while
# excluding Alpine musl's /usr/include so only the macOS SDK headers are seen.
RUN mkdir -p /opt/osxcross/target/SDK /opt/osxcross/target/bin \
    && wget -q "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOS_SDK_VERSION}/MacOSX${MACOS_SDK_VERSION}.sdk.tar.xz" \
         -O /tmp/MacOSX.sdk.tar.xz \
    && tar xJf /tmp/MacOSX.sdk.tar.xz -C /opt/osxcross/target/SDK \
    && rm /tmp/MacOSX.sdk.tar.xz \
    && SDK="/opt/osxcross/target/SDK/MacOSX${MACOS_SDK_VERSION}.sdk" \
    && MACVER="${MACOS_SDK_VERSION}" \
    && for triple in x86_64-apple-darwin23 arm64-apple-darwin23; do \
           printf '#!/bin/sh\nexec clang --target=%s -isysroot %s -mmacosx-version-min=%s -nostdlibinc -isystem %s/usr/include "$@"\n' \
               "$triple" "$SDK" "$MACVER" "$SDK" > "/opt/osxcross/target/bin/${triple}-clang" ; \
           printf '#!/bin/sh\nexec clang++ --target=%s -isysroot %s -mmacosx-version-min=%s -nostdlibinc -isystem %s/usr/include "$@"\n' \
               "$triple" "$SDK" "$MACVER" "$SDK" > "/opt/osxcross/target/bin/${triple}-clang++" ; \
           ln -sf "${triple}-clang"          "/opt/osxcross/target/bin/${triple}-cc"     ; \
           ln -sf "${triple}-clang++"        "/opt/osxcross/target/bin/${triple}-c++"    ; \
           ln -sf "${triple}-clang"          "/opt/osxcross/target/bin/${triple}-gcc"    ; \
           ln -sf /usr/bin/llvm-ar           "/opt/osxcross/target/bin/${triple}-ar"     ; \
           ln -sf /usr/bin/llvm-ranlib       "/opt/osxcross/target/bin/${triple}-ranlib" ; \
           ln -sf /usr/bin/llvm-nm           "/opt/osxcross/target/bin/${triple}-nm"     ; \
           ln -sf /usr/local/bin/cross-nostrip "/opt/osxcross/target/bin/${triple}-strip" ; \
           chmod +x "/opt/osxcross/target/bin/${triple}-clang" \
                    "/opt/osxcross/target/bin/${triple}-clang++" ; \
       done

# FreeBSD sysroots + clang wrapper scripts
RUN mkdir -p /opt/freebsd-amd64 /opt/freebsd-arm64 \
    && wget -q "https://download.freebsd.org/releases/amd64/amd64/${FREEBSD_VERSION}-RELEASE/base.txz" \
         -O /tmp/freebsd-amd64-base.txz \
    && tar xJf /tmp/freebsd-amd64-base.txz -C /opt/freebsd-amd64 ./lib ./usr/lib ./usr/include \
    && rm /tmp/freebsd-amd64-base.txz \
    && wget -q "https://download.freebsd.org/releases/arm64/aarch64/${FREEBSD_VERSION}-RELEASE/base.txz" \
         -O /tmp/freebsd-arm64-base.txz \
    && tar xJf /tmp/freebsd-arm64-base.txz -C /opt/freebsd-arm64 ./lib ./usr/lib ./usr/include \
    && rm /tmp/freebsd-arm64-base.txz \
    && printf '#!/bin/sh\nexec clang --target=x86_64-unknown-freebsd%s --sysroot=/opt/freebsd-amd64 "$@"\n' "${FREEBSD_VERSION}" \
         > /usr/local/bin/freebsd-amd64-cc \
    && printf '#!/bin/sh\nexec clang++ --target=x86_64-unknown-freebsd%s --sysroot=/opt/freebsd-amd64 "$@"\n' "${FREEBSD_VERSION}" \
         > /usr/local/bin/freebsd-amd64-c++ \
    && printf '#!/bin/sh\nexec clang --target=aarch64-unknown-freebsd%s --sysroot=/opt/freebsd-arm64 "$@"\n' "${FREEBSD_VERSION}" \
         > /usr/local/bin/freebsd-arm64-cc \
    && printf '#!/bin/sh\nexec clang++ --target=aarch64-unknown-freebsd%s --sysroot=/opt/freebsd-arm64 "$@"\n' "${FREEBSD_VERSION}" \
         > /usr/local/bin/freebsd-arm64-c++ \
    && chmod +x /usr/local/bin/freebsd-amd64-cc /usr/local/bin/freebsd-amd64-c++ \
                /usr/local/bin/freebsd-arm64-cc /usr/local/bin/freebsd-arm64-c++

ENV PKG_CONFIG_ALLOW_SYSTEM_CFLAGS=1 \
    PKG_CONFIG_ALLOW_SYSTEM_LIBS=1

WORKDIR /build

COPY <<'EOF' /usr/local/bin/build-ffmpeg
#!/bin/sh
set -eu

TARGET="${1:-linux-amd64}"
FFMPEG_VERSION="${2:-}"

LINUX_FEATURE_FLAGS="
    --enable-gpl
    --enable-version3
    --enable-nonfree
    --enable-static
    --disable-shared
    --disable-debug
    --disable-doc
    --disable-ffplay
    --enable-libx264
    --enable-libx265
    --enable-libvpx
    --enable-libopus
    --enable-libvorbis
    --enable-libmp3lame
    --enable-libfdk-aac
    --enable-libaom
    --enable-libdav1d
    --enable-libsvtav1
    --enable-libass
    --enable-libfreetype
    --enable-libfontconfig
    --enable-libvidstab
    --enable-librubberband
    --enable-libzimg
    --enable-openssl
"

BASIC_FEATURE_FLAGS="
    --enable-gpl
    --enable-version3
    --enable-nonfree
    --enable-static
    --disable-shared
    --disable-debug
    --disable-doc
    --disable-ffplay
"

EXTRA_LIBS=''
LINUX_ARCH=''

case "$TARGET" in
    linux-amd64)
        FEATURE_FLAGS="$LINUX_FEATURE_FLAGS"
        LINUX_ARCH=amd64
        export CC=gcc CXX=g++ AR=ar RANLIB=ranlib STRIP=strip
        export PKG_CONFIG_PATH=/opt/deps/amd64/lib/pkgconfig
        export PKG_CONFIG_LIBDIR=/opt/deps/amd64/lib/pkgconfig:/usr/lib/pkgconfig:/usr/local/lib/pkgconfig:/usr/share/pkgconfig
        unset PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_ALLOW_CROSS
        CROSS_FLAGS=''
        EXTRA_CFLAGS='-O2 -I/opt/deps/amd64/include -static'
        EXTRA_LDFLAGS='-static -Wl,-z,stack-size=1048576 -L/opt/deps/amd64/lib'
        EXTRA_LIBS='-lpthread -lm -lstdc++'
        STRIP_CMD=strip
        EXT=''
        ;;
    linux-arm64)
        FEATURE_FLAGS="$LINUX_FEATURE_FLAGS"
        LINUX_ARCH=arm64
        export PATH="/opt/aarch64-linux-musl/bin:${PATH}"
        export CC=/opt/aarch64-linux-musl/bin/aarch64-linux-gcc
        export CXX=/opt/aarch64-linux-musl/bin/aarch64-linux-g++
        export AR=/opt/aarch64-linux-musl/bin/aarch64-linux-ar
        export RANLIB=/opt/aarch64-linux-musl/bin/aarch64-linux-ranlib
        export STRIP=/opt/aarch64-linux-musl/bin/aarch64-linux-strip
        export PKG_CONFIG_PATH=/opt/deps/arm64/lib/pkgconfig
        export PKG_CONFIG_LIBDIR=/opt/deps/arm64/lib/pkgconfig:/opt/sysroots/aarch64/usr/lib/pkgconfig:/opt/sysroots/aarch64/usr/share/pkgconfig
        export PKG_CONFIG_SYSROOT_DIR=/opt/sysroots/aarch64
        export PKG_CONFIG_ALLOW_CROSS=1
        CROSS_FLAGS='--enable-cross-compile --cross-prefix=/opt/aarch64-linux-musl/bin/aarch64-linux- --arch=aarch64 --target-os=linux --sysroot=/opt/sysroots/aarch64'
        EXTRA_CFLAGS='-O2 -I/opt/deps/arm64/include -I/opt/sysroots/aarch64/usr/include'
        EXTRA_LDFLAGS='-static -Wl,-z,stack-size=1048576 -L/opt/deps/arm64/lib -L/opt/sysroots/aarch64/usr/lib'
        EXTRA_LIBS='-lpthread -lm -lstdc++'
        STRIP_CMD=/opt/aarch64-linux-musl/bin/aarch64-linux-strip
        EXT=''
        ;;
    windows-amd64)
        FEATURE_FLAGS="$BASIC_FEATURE_FLAGS"
        CROSS_FLAGS='--enable-cross-compile --cross-prefix=x86_64-w64-mingw32- --arch=x86_64 --target-os=mingw32'
        EXTRA_CFLAGS='-O2'
        EXTRA_LDFLAGS='-static'
        STRIP_CMD='x86_64-w64-mingw32-strip'
        EXT='.exe'
        ;;
    windows-arm64)
        # windows-arm64 requires llvm-mingw which is a glibc binary that
        # crashes on Alpine/musl. This target is built on ubuntu-latest in CI;
        # see build-binaries.yml windows-arm64 job.
        echo "windows-arm64 is not supported in this container — use the ubuntu-latest CI job." >&2
        exit 1
        ;;
    darwin-amd64)
        # Explicitly disable Linux/macOS-framework devices; configure may have
        # auto-detected them incorrectly if SDK headers were not yet active.
        FEATURE_FLAGS="$BASIC_FEATURE_FLAGS --disable-videotoolbox --disable-audiotoolbox"
        export PATH="/opt/osxcross/target/bin:${PATH}"
        CROSS_FLAGS='--enable-cross-compile --cross-prefix=x86_64-apple-darwin23- --arch=x86_64 --target-os=darwin --cc=x86_64-apple-darwin23-clang --cxx=x86_64-apple-darwin23-clang++'
        EXTRA_CFLAGS='-O2'
        EXTRA_LDFLAGS='-fuse-ld=lld'
        STRIP_CMD='x86_64-apple-darwin23-strip'
        EXT=''
        ;;
    darwin-arm64)
        FEATURE_FLAGS="$BASIC_FEATURE_FLAGS --disable-videotoolbox --disable-audiotoolbox"
        export PATH="/opt/osxcross/target/bin:${PATH}"
        CROSS_FLAGS='--enable-cross-compile --cross-prefix=arm64-apple-darwin23- --arch=aarch64 --target-os=darwin --cc=arm64-apple-darwin23-clang --cxx=arm64-apple-darwin23-clang++'
        EXTRA_CFLAGS='-O2'
        EXTRA_LDFLAGS='-fuse-ld=lld'
        STRIP_CMD='arm64-apple-darwin23-strip'
        EXT=''
        ;;
    freebsd-amd64)
        FEATURE_FLAGS="$BASIC_FEATURE_FLAGS"
        # --ld omitted so configure link tests go through freebsd-amd64-cc
        # (which carries --sysroot), allowing posix_memalign to resolve.
        # -fuse-ld=lld in EXTRA_LDFLAGS selects lld for the final link.
        # -lmd: FreeBSD 14 moved SHA256 routines into libmd.
        CROSS_FLAGS='--enable-cross-compile --arch=x86_64 --target-os=freebsd --sysroot=/opt/freebsd-amd64 --cc=freebsd-amd64-cc --cxx=freebsd-amd64-c++ --strip=/usr/local/bin/cross-nostrip'
        EXTRA_CFLAGS='-O2 -D_POSIX_C_SOURCE=200112L'
        EXTRA_LDFLAGS='-static -fuse-ld=lld'
        EXTRA_LIBS='-lmd'
        STRIP_CMD='/usr/local/bin/cross-nostrip'
        EXT=''
        ;;
    freebsd-arm64)
        FEATURE_FLAGS="$BASIC_FEATURE_FLAGS"
        CROSS_FLAGS='--enable-cross-compile --arch=aarch64 --target-os=freebsd --sysroot=/opt/freebsd-arm64 --cc=freebsd-arm64-cc --cxx=freebsd-arm64-c++ --strip=/usr/local/bin/cross-nostrip'
        EXTRA_CFLAGS='-O2 -D_POSIX_C_SOURCE=200112L'
        EXTRA_LDFLAGS='-static -fuse-ld=lld'
        EXTRA_LIBS='-lmd'
        STRIP_CMD='/usr/local/bin/cross-nostrip'
        EXT=''
        ;;
    *)
        echo "Unknown target: $TARGET" >&2
        echo "Targets: linux-amd64 linux-arm64 windows-amd64 darwin-amd64 darwin-arm64 freebsd-amd64 freebsd-arm64" >&2
        echo "Note: windows-arm64 builds on ubuntu-latest in CI (not in this container)" >&2
        exit 1
        ;;
esac

if [ -z "$FFMPEG_VERSION" ]; then
    FFMPEG_VERSION=$(
        wget -qO- https://ffmpeg.org/releases/ |
            grep -oE 'ffmpeg-[0-9]+\.[0-9]+(\.[0-9]+)?' |
            sed 's/ffmpeg-//' |
            sort -V |
            tail -1
    )
fi

echo "Building FFmpeg ${FFMPEG_VERSION} for ${TARGET}..."

if [ -n "$LINUX_ARCH" ]; then
    sed -i 's/ -lgcc_s -lgcc -lgcc_s -lgcc//g' "/opt/deps/${LINUX_ARCH}/lib/pkgconfig/x265.pc"
fi

cd /build
rm -rf "ffmpeg-${FFMPEG_VERSION}" "ffmpeg-${FFMPEG_VERSION}.tar.xz"
wget -q "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"
tar xJf "ffmpeg-${FFMPEG_VERSION}.tar.xz"
cd "ffmpeg-${FFMPEG_VERSION}"

# shellcheck disable=SC2086
./configure \
    --prefix=/build/ffmpeg-install \
    ${FEATURE_FLAGS} \
    ${CROSS_FLAGS} \
    --pkg-config=pkg-config \
    --pkg-config-flags='--static' \
    --extra-cflags="${EXTRA_CFLAGS}" \
    --extra-ldflags="${EXTRA_LDFLAGS}" \
    ${EXTRA_LIBS:+--extra-libs="${EXTRA_LIBS}"} \
    || { cat ffbuild/config.log; exit 1; }

make -j"$(nproc)"
${STRIP_CMD} "ffmpeg${EXT}" "ffprobe${EXT}" 2>/dev/null || true

mkdir -p /output
cp "ffmpeg${EXT}"  "/output/ffmpeg-${TARGET}${EXT}"
cp "ffprobe${EXT}" "/output/ffprobe-${TARGET}${EXT}"
echo "${FFMPEG_VERSION}" > /output/VERSION
echo "Built: ffmpeg-${TARGET}${EXT}, ffprobe-${TARGET}${EXT}"
EOF

RUN chmod +x /usr/local/bin/build-ffmpeg

WORKDIR /workspace
VOLUME ["/workspace", "/output"]
CMD ["echo", "Usage: build-ffmpeg [linux-amd64|linux-arm64|windows-amd64|darwin-amd64|darwin-arm64|freebsd-amd64|freebsd-arm64] [version]"]
